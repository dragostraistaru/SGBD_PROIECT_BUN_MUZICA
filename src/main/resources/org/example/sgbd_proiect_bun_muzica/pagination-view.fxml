<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.sgbd_proiect_bun_muzica.controller.PaginationDemoController">
    <top>
        <VBox style="-fx-padding: 15; -fx-background-color: #f0f0f0;">
            <Label text="CERINTA 3: PAGINARE - OFFSET vs CURSOR" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
            <Label fx:id="subtitleLabel" style="-fx-font-size: 12; -fx-text-fill: #666;"/>
        </VBox>
    </top>
    <center>
        <VBox style="-fx-padding: 15;">
            <Label text="Albume (10.000 total):" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
            <TableView fx:id="albumTable" prefHeight="400" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn text="ID" prefWidth="60" fx:id="idColumn"/>
                    <TableColumn text="Titlu" prefWidth="300" fx:id="titleColumn"/>
                    <TableColumn text="An" prefWidth="80" fx:id="yearColumn"/>
                    <TableColumn text="Artist" prefWidth="150" fx:id="artistColumn"/>
                </columns>
            </TableView>
            <Label fx:id="loadTimeLabel" style="-fx-font-size: 11; -fx-text-fill: #0066cc; -fx-padding: 5;"/>
        </VBox>
    </center>
    <bottom>
        <VBox style="-fx-padding: 15; -fx-background-color: #f9f9f9; -fx-border-color: #ddd; -fx-border-width: 1 0 0 0;">
            <!-- Strategy Selection -->
            <HBox spacing="10" style="-fx-padding: 0 0 15 0;">
                <Label text="Strategie:" style="-fx-font-weight: bold;"/>
                <ToggleButton fx:id="offsetToggle" text="OFFSET/LIMIT" style="-fx-padding: 5 15;"/>
                <ToggleButton fx:id="cursorToggle" text="CURSOR (KEYSET)" style="-fx-padding: 5 15;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="BENCHMARK" onAction="#onBenchmark" style="-fx-padding: 5 15; -fx-font-size: 11;"/>
            </HBox>
            <HBox spacing="10" style="-fx-padding: 0 0 10 0;">
                <Label text="Marime pagina:" style="-fx-font-weight: bold;"/>
                <ComboBox fx:id="pageSizeCombo" prefWidth="100"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="totalLabel" style="-fx-font-weight: bold;"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER">
                <Button fx:id="firstBtn" text="Primul" onAction="#onFirst" style="-fx-padding: 8 15;"/>
                <Button fx:id="prevBtn" text="Anterior" onAction="#onPrevious" style="-fx-padding: 8 15;"/>
                <Label text="Pagina" style="-fx-font-weight: bold;"/>
                <Spinner fx:id="pageSpinner" prefWidth="80" style="-fx-padding: 5;"/>
                <Label text="din" style="-fx-font-weight: bold;"/>
                <Label fx:id="totalPagesLabel" style="-fx-font-weight: bold; -fx-min-width: 50;"/>
                <Button fx:id="nextBtn" text="Urmator" onAction="#onNext" style="-fx-padding: 8 15;"/>
                <Button fx:id="lastBtn" text="Ultimul" onAction="#onLast" style="-fx-padding: 8 15;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="statusLabel" style="-fx-text-fill: #0066cc; -fx-font-size: 11;"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>